# ---- Telegram ----
BOT_TOKEN=123456:ABC-from-BotFather
# admin Telegram IDs, comma-separated (users can get their ID with /myid)
ADMIN_IDS=111111111,222222222
# public HTTPS URL; empty = polling mode (local development)
WEBHOOK_BASE_URL=
# random string: openssl rand -hex 32
WEBHOOK_SECRET=

# ---- Business ----
VAT_RATE=12
COMPANY_NAME=ООО «Компания»
COMPANY_INN=123456789
TIMEZONE=Asia/Tashkent
# uz | ru | en: bot language when the user's Telegram language is unknown, panel default
DEFAULT_LANGUAGE=ru

# ---- Admin panel ----
# random string: openssl rand -hex 32
ADMIN_SECRET_KEY=c134a912f0aea0afbd868c43e54b3d8de15a14b568ba3a35ad6557dcc5e2686c

# ---- Infrastructure (docker-compose) ----
DOMAIN=bot.example.uz
POSTGRES_USER=salesbot
POSTGRES_PASSWORD=
POSTGRES_DB=salesbot
# for running outside docker-compose (local dev):
DATABASE_URL=postgresql+asyncpg://salesbot:salesbot@localhost:5432/salesbot
REDIS_URL=redis://localhost:6379/0

# ---- Monitoring ----
SENTRY_DSN=
ENVIRONMENT=development
